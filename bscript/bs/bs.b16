// bs - the BScript script loader (the "BScript" specification, sect. 11.4).
//
//   bs script.bs [args...]
//
// Chooses the cache file, checks that it is valid (version, path of the main source, MTIME of all
// sources) and runs EXEC into bsvm (the cache is valid) or into bsc --run (it is not).
include "sys.b16"
option max_top = $4000          // 16 KB: enough for the loader, the rest is bsvm or bsc after EXEC
include "bsdefs.b16"
include "util.b16"

var cwd: [PATHMAX]byte
var abs: [PATHMAX]byte
var cache: [PATHMAX + 8]byte
var cmd: [300]byte
var hdr: [HDR_SIZE / 2]uint

fn fail2(obj: ptr byte, msg: ptr byte): int {
    fputs(STDERR, "bs: ")
    if obj != 0 { fputs(STDERR, obj); fputs(STDERR, ": ") }
    fputs(STDERR, msg)
    fputs(STDERR, "\n")
    return 2
}

// the directory is read-only: the directory's RDONLY flag or a read-only volume
fn dir_readonly(p: ptr byte): uint {
    var d: [PATHMAX]byte
    dir_of(&d[0], p)
    var st: Stat
    if sys_stat(&d[0], &st) == OK && uint(st.size >> 16) & A_RDONLY != 0 { return 1 }
    var vi: VolInfo
    if sys_volinfo(drive_num(p[0]), &vi) == OK && vi.flags & MNT_RDONLY != 0 { return 1 }
    return 0
}

fn rd(h: uint, p: ptr byte, n: uint): uint {
    var e, r: uint
    e, r = sys_read(h, p, n)
    return uint(e == OK && r == n)
}

// is the cache valid (sect. 11.4, item 3)
fn cache_ok(): uint {
    var e, h: uint
    e, h = sys_open(&cache[0], O_READ, 0)
    if e != OK { return 0 }
    var ok: uint = 0
    if rd(h, ptr byte(&hdr[0]), HDR_SIZE) != 0 && hdr[0] == ('B' | 'S' << 8) && hdr[1] == ('C' | '1' << 8) &&
       hdr[H_VERSION / 2] == BSC_VERSION {
        var n = hdr[H_NFILES / 2]
        var k: uint = 0
        ok = 1
        while k < n && ok != 0 {
            var mt: [2]uint
            var len: [2]byte
            var p: [PATHMAX]byte
            if rd(h, ptr byte(&mt[0]), 4) == 0 || rd(h, &len[0], 1) == 0 || rd(h, &p[0], uint(len[0])) == 0 {
                ok = 0
                break
            }
            p[len[0]] = 0
            if k == 0 && strieq(&p[0], &abs[0]) == 0 { ok = 0 }
            var st: Stat
            if sys_stat(&p[0], &st) != OK || uint(st.mtime) != mt[0] || uint(st.mtime >> 16) != mt[1] { ok = 0 }
            k++
        }
    }
    ign = sys_close(h)
    return ok
}

var cl_n: uint
fn cl_add(s: ptr byte): uint {
    var q: uint = uint(*s == 0)
    var t = s
    while *t != 0 {
        if *t == ' ' || *t == 9 { q = 1 }
        if *t == '"' { return 1 }
        t++
    }
    if cl_n + strlen(s) + 3 > 255 { return 1 }
    if cl_n != 0 { cmd[cl_n] = ' '; cl_n++ }
    if q != 0 { cmd[cl_n] = '"'; cl_n++ }
    strcpy(&cmd[cl_n], s)
    cl_n += strlen(s)
    if q != 0 { cmd[cl_n] = '"'; cl_n++ }
    cmd[cl_n] = 0
    return 0
}

fn main(argc: uint, argv: ptr ptr byte): int {
    if argc < 2 {
        fputs(STDERR, "usage: bs script.bs [args...]\n")
        return 2
    }
    var e, n: uint
    e, n = sys_getcwd(&cwd[0], PATHMAX)
    if make_abs(&abs[0], &cwd[0], argv[1]) == 0 { return fail2(argv[1], "invalid path") }
    var st: Stat
    e = sys_stat(&abs[0], &st)
    if e != OK { return fail2(argv[1], "no such file or directory") }
    // cache file
    var l = strlen(&abs[0])
    var ext = uint(l >= 3 && abs[l - 3] == '.' && chfold(abs[l - 2]) == 'b' && chfold(abs[l - 1]) == 's')
    if dir_readonly(&abs[0]) != 0 {
        strcpy(&cache[0], "A:/tmp/")
        var b = &abs[0]
        var p = &abs[0]
        while *p != 0 { if *p == '/' { b = p + 1 }; p++ }
        strcpy(&cache[7], b)
    } else {
        strcpy(&cache[0], &abs[0])
    }
    l = strlen(&cache[0])
    if ext != 0 { cache[l] = 'c'; cache[l + 1] = 0 } else { strcpy(&cache[l], ".bsc") }
    cl_n = 0
    if cache_ok() != 0 {
        ign = cl_add("A:/bin/bsvm.cx")
    } else {
        ign = cl_add("A:/bin/bsc.cx")
        ign = cl_add("--run")
    }
    var bad = cl_add(&cache[0]) | cl_add(&abs[0])
    var i: uint = 2
    while i < argc { bad |= cl_add(argv[i]); i++ }
    if bad != 0 { return fail2(argv[1], "bad arguments") }
    e = sys_exec(&cmd[0])
    var prog: ptr byte = "A:/bin/bsvm.cx"
    if cmd[9] == 'c' { prog = "A:/bin/bsc.cx" }
    if e == E_NOENT { return fail2(prog, "no such file or directory") }
    if e == E_NOMEM { return fail2(prog, "not enough memory") }
    return fail2(prog, "cannot run")
}
