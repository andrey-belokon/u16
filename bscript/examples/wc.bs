// run: bs /ex/wc.bs /ex/data/poem.txt /ex/data/none.txt /ex/data/notes.txt
// wc.bs - lines, words and bytes of files; without arguments - standard input.
//
//   wc [file ...]
//
// Like the shell utilities: a file read error is reported ("wc: path: text"), processing
// continues, the exit code is 1 if at least one file was not read.
include "lib/text.bs"

fn count(text: string): int, int, int {
    var lines = text.lines()
    var nw = 0
    for l in lines {
        nw += words(l).len()
    }
    return lines.len(), nw, text.len()
}

fn report(l: int, w: int, b: int, name: string) {
    println($"{|rjust(l, 6)|} {|rjust(w, 6)|} {|rjust(b, 7)|}  {|name|}")
}

fn main(args: array): int {
    if args.len() == 0 {
        var l, w, b = count(io.read_all())
        report(l, w, b, "")
        return 0
    }
    var bad = 0
    var tl = 0
    var tw = 0
    var tb = 0
    for name in args {
        var text, err = fs.read_text(name)
        if err != null {
            warn(err)
            bad = 1
            continue
        }
        var l, w, b = count(text)
        report(l, w, b, name)
        tl += l
        tw += w
        tb += b
    }
    if args.len() > 1 {
        report(tl, tw, tb, "total")
    }
    return bad
}
