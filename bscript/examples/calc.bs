// run: bs /ex/calc.bs < /ex/data/calc.txt
// calc.bs - a calculator: lines of expressions from standard input.
//
//   calc < expressions
//
// Recursive descent over the text, variables "x = expression", parse errors are error values
// (fail) with their own code, each line intercepted separately.

const E_SYNTAX = 1001

var src = ""
var pos = 0
var vars = {"answer": 42}

fn skip() {
    while pos < src.len() && src[pos] == ' ' { pos++ }
}

fn peek(): int {
    skip()
    if pos >= src.len() { return 0 }
    return src[pos]
}

fn syntax(msg: string) {
    fail $"{|msg|} at column {|pos + 1|}", null, E_SYNTAX
}

fn is_digit(c: int): bool { return c >= '0' && c <= '9' }
fn is_alpha(c: int): bool { return c >= 'a' && c <= 'z' || c == '_' }

fn number(): int {
    var s = pos
    while pos < src.len() && is_digit(src[pos]) { pos++ }
    return src.slice(s, pos).to_int()       // overflow is the errors.NUMBER error
}

fn name(): string {
    var s = pos
    while pos < src.len() && (is_alpha(src[pos]) || is_digit(src[pos])) { pos++ }
    return src.slice(s, pos)
}

fn primary(): int {
    var c = peek()
    if c == '(' {
        pos++
        var v = expr()
        if peek() != ')' { syntax("expected )") }
        pos++
        return v
    }
    if c == '-' {
        pos++
        return -primary()
    }
    if is_digit(c) { return number() }
    if is_alpha(c) {
        var n = name()
        var v = vars[n]
        if v == null { fail "undefined variable", n }
        return v
    }
    if c == 0 { syntax("unexpected end") }
    syntax($"unexpected '{|str.from_byte(c)|}'")
    return 0
}

fn term(): int {
    var v = primary()
    loop {
        var c = peek()
        if c == '*' {
            pos++
            v *= primary()
        } else if c == '/' || c == '%' {
            pos++
            var d = primary()
            if d == 0 { fail "division by zero" }
            if c == '/' { v /= d } else { v %= d }
        } else {
            return v
        }
    }
}

fn expr(): int {
    var v = term()
    loop {
        var c = peek()
        if c == '+' { pos++; v += term() }
        else if c == '-' { pos++; v -= term() }
        else { return v }
    }
}

// A line: "name = expression" or an expression.
fn line(text: string): int {
    src = text
    pos = 0
    var target = ""
    if is_alpha(peek()) {
        var save = pos
        var n = name()
        if peek() == '=' {
            pos++
            target = n
        } else {
            pos = save
        }
    }
    var v = expr()
    if peek() != 0 { syntax("extra text") }
    if target != "" { vars[target] = v }
    return v
}

var n = 0
loop {
    var text = io.read_line()
    if text == null { break }
    text = text.trim()
    if text == "" || text.starts_with("#") { continue }
    n++
    var v, err = line(text)
    if err == null {
        println($"{|text|} = {|v|}")
    } else if err.code() == E_SYNTAX {
        println($"{|text|}: syntax error: {|err.text()|}")
    } else {
        println($"{|text|}: {|err|}")
    }
}
println($"{|n|} lines")
