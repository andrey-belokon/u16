// run: bs /ex/grep.bs -n -i THE /ex/data/poem.txt /ex/data/notes.txt
// grep.bs - the lines of files that contain a substring.
//
//   grep [-i] [-n] [-c] pattern [file ...]
//
//   -i  ignore letter case (Latin and Cyrillic)
//   -n  line numbers
//   -c  only the number of matches
//
// Exit code: 0 - there are matches, 1 - none, 2 - an error (as with Unix grep).

fn usage(): int {
    eprintln("usage: grep [-i] [-n] [-c] pattern [file ...]")
    return 2
}

fn main(args: array): int {
    var fold = false
    var numbers = false
    var only_count = false
    var i = 0
    while i < args.len() && args[i].starts_with("-") {
        switch args[i] {
        case "-i":
            fold = true
        case "-n":
            numbers = true
        case "-c":
            only_count = true
        default:
            return usage()
        }
        i++
    }
    if i >= args.len() {
        return usage()
    }
    var pattern = args[i]
    if fold {
        pattern = pattern.lower()
    }
    var files = args.slice(i + 1)
    var many = files.len() > 1
    var found = 0
    var status = 0
    for name in files {
        var f, err = fs.open(name, "r")
        if err != null {
            eprintln($"grep: {|err|}")
            status = 2
            continue
        }
        var n = 0
        var hits = 0
        loop {
            var line = f.read_line()
            if line == null { break }
            n++
            var hay = line
            if fold { hay = line.lower() }
            if !(pattern in hay) { continue }
            hits++
            if only_count { continue }
            var prefix = ""
            if many { prefix = name + ":" }
            if numbers { prefix += str(n) + ":" }
            println(prefix + line)
        }
        f.close()
        if only_count {
            if many { print(name + ":") }
            println(hits)
        }
        found += hits
    }
    if status != 0 { return status }
    if found == 0 { return 1 }
    return 0
}
