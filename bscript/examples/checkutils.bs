// run: bs /ex/checkutils.bs
// checkutils.bs - a check of the shell utilities: running programs, capturing output, redirection.
//
// Each check is a function that fails (fail) if the result is wrong.
// The script runs all checks and prints a summary; the exit code is the number of failures.

const DIR = "A:/tmp/chk"

fn expect(name: string, got: value, want: value) {
    if got != want {
        fail $"got {|got|}, want {|want|}", name
    }
}

fn run_ok(prog: string, args: array) {
    var code = proc.run(prog, args)
    expect(prog, code, 0)
}

fn t_mkdir() {
    run_ok("mkdir", [DIR])
    expect("is_dir", fs.is_dir(DIR), true)
}

fn t_cat() {
    fs.write_text(DIR + "/a.txt", "alpha\nbeta\n")
    var code, out = proc.capture("cat", [DIR + "/a.txt"])
    expect("cat code", code, 0)
    expect("cat output", out, "alpha\nbeta\n")
}

fn t_cp_mv() {
    run_ok("cp", [DIR + "/a.txt", DIR + "/b.txt"])
    run_ok("mv", [DIR + "/b.txt", DIR + "/c.txt"])
    expect("b.txt", fs.exists(DIR + "/b.txt"), false)
    expect("c.txt", fs.read_text(DIR + "/c.txt"), "alpha\nbeta\n")
}

fn t_ls() {
    var code, out = proc.capture("ls", [DIR])
    expect("ls", out, "a.txt\nc.txt\n")
}

fn t_redirect() {
    proc.run("cat", [], {"stdin": DIR + "/a.txt", "stdout": DIR + "/d.txt"})
    expect("redirect", fs.read_text(DIR + "/d.txt"), "alpha\nbeta\n")
}

fn t_errors() {
    var code = proc.run("cat", [DIR + "/none"], {"stderr": DIR + "/err.txt"})
    expect("cat missing: code", code, 1)
    expect("cat missing: message", fs.read_text(DIR + "/err.txt").trim(),
           "cat: " + DIR + "/none: no such file or directory")
    var c2, e2 = proc.run("no-such-program", [])
    expect("missing program", e2, errors.NOENT)
}

fn t_rm() {
    for f in fs.list(DIR) {
        run_ok("rm", [path.join(DIR, f["name"])])
    }
    run_ok("rmdir", [DIR])
    expect("removed", fs.exists(DIR), false)
}

var names = ["mkdir", "cat", "cp_mv", "ls", "redirect", "errors", "rm"]
var failed = 0
for i, n in names {
    var err: error
    switch i {
    case 0: err = t_mkdir()
    case 1: err = t_cat()
    case 2: err = t_cp_mv()
    case 3: err = t_ls()
    case 4: err = t_redirect()
    case 5: err = t_errors()
    case 6: err = t_rm()
    }
    if err == null {
        println($"ok    {|n|}")
    } else {
        println($"FAIL  {|n|}: {|err|}")
        failed++
    }
}
println($"{|names.len() - failed|} of {|names.len()|} passed")
return failed
