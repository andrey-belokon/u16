// String methods (sect. 9.2), str (10.2)
var s = "  Hello, World  "
var t = s.trim()
println($"[{|t|}] {|t.len()|}")
println(t.slice(7))
println(t.slice(0, 5))
println(t.find("o"))
println(t.find("o", 5))
println(t.find("zz"))
println(t.contains("World"))
println(t.starts_with("Hell") && t.ends_with("ld") && !t.starts_with("x"))
println(str.join("a,,b".split(","), "|"))
println("".split(",").len())
var ls = "one\r\ntwo\n\nthree\n".lines()
println($"{|ls.len()|} {|str.join(ls, "/")|}")
println("".lines().len())
println("a-b-c".replace("-", "+="))
println(t.upper() + " " + t.lower())
println("Привет Ёж".upper())
println("ПРИВЕТ ЁЖ".lower())
println("ReadMe.TXT".equal_fold("readme.txt"))
println("ab".repeat(3) + "|" + "x".repeat(0) + "|")
println("7".pad_left(3, '0') + " [" + "ab".pad_right(4) + "] " + "long".pad_left(2))
for x in ["12", " -32768 ", "+5", "$FFFF", "0x10", "0b101", "32768", "abc", "", "-"] {
    var v, err = x.to_int()
    println($"{|x|} -> {|v|} {|err|}")
}
println(str.from_byte(65) + str.hex(-1) + " " + str.hex(10, 4) + " " + str.hex(0))
println("abc"[1])
println(str([1, 2]) + str({"a": 1}) + str(null))
var big = "x".repeat(100)
println(big.len())
