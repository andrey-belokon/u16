// sort: random, ordered, reversed, repeats, strings, short arrays
fn check(a: array, what: string) {
    var i = 1
    while i < a.len() {
        if a[i - 1] > a[i] { println($"{|what|}: not sorted at {|i|}"); return }
        i++
    }
    println($"{|what|}: ok {|a.len()|}")
}
var r = []
var x = 7
var i = 0
while i < 400 { x = x * 75 + 74; r.push(x % 50 - 25); i++ }
var c = r.clone()
c.sort()
check(c, "random")
c.sort()
check(c, "sorted")
c.reverse()
c.sort()
check(c, "reversed")
var same = []
i = 0
while i < 100 { same.push(5); i++ }
same.sort()
check(same, "equal")
for n in [0, 1, 2, 3, 13, 14] {
    var a = []
    i = 0
    while i < n { a.push((n - i) * 3 % 7); i++ }
    a.sort()
    check(a, $"n={|n|}")
}
var w = ["pear", "Apple", "fig", "apple", "", "ёж", "яблоко", "банан"]
w.sort()
println(str.join(w, ","))
var bad = [1, "x"]
bad.sort()
