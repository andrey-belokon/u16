// Processes (sect. 10.7)
println(proc.which("ls"))
println(proc.which("child"))
println(proc.which("/t/child.bs"))
println(proc.which("nosuch"))
var code = proc.run("child", ["a b", "", "c"])
println($"code {|code|}")
var c2, out = proc.capture("child", ["x"])
println($"capture {|c2|} [{|out|}]")
var c3, o3 = proc.capture("cat", ["/t/data/in.txt"])
println(o3.lines().len())
proc.run("cat", [], {"stdin": "/t/data/in.txt", "stdout": "/t/out1.txt"})
println(fs.read_text("/t/out1.txt").len())
proc.run("child", ["y"], {"stdout": "/t/out1.txt", "append": true})
print(fs.read_text("/t/out1.txt"))
proc.run("child", ["err"], {"stdout": "/t/o2.txt", "stderr": "/t/o2.txt"})
print(fs.read_text("/t/o2.txt"))
var r, e = proc.run("nosuch", [])
println(e)
var r2, e2 = proc.run("ls", ["a\"b"])
println(e2)
var r3, e3 = proc.run("cat", [], {"stdin": "/t/none.txt"})
println(e3)
proc.run("ls", ["/t/inc"])
time.sleep(1)
proc.exit(3)
println("not here")
