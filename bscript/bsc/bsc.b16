// bsc - the BScript compiler (the "BScript" specification, sect. 11.2, 12.6).
//
//   bsc [-l] source.bs [-o out.bsc]
//   bsc --run cache.bsc source.bs [args...]
//
// Single-pass recursive descent with code generation and a preliminary pass over declarations.
// Exit codes: 0 - success, 1 - an error in the program, 2 - an invocation or I/O error.
include "sys.b16"
option max_top = $C000          // 48 KB: the compiler tables and the code buffer
include "bsdefs.b16"
include "util.b16"
include "lex.b16"
include "sym.b16"
include "builtins.b16"
include "expr.b16"
include "stmt.b16"
include "xbuf.b16"
include "list.b16"

var nglob: uint
var cwd: [PATHMAX]byte

// ---- common start of a pass ------------------------------------------------------------------------
fn start_pass(main_path: ptr byte) {
    nfiles = 0
    srcused = 0
    depth = 0
    trig = 0; nest = 0; interp = 0
    ign = add_src(main_path)
    open_src(0)
    tline = 1; tcol = 1; tfile = 0
    pline = 1; pfile = 0
    next()
}

fn do_include() {
    if decl_seen != 0 { err("include must come before declarations and statements") }
    next()
    if tok != T_STR { err("file name expected") }
    var p: [PATHMAX]byte
    if tlen >= PATHMAX - 1 { err("path too long") }
    memcpy(&p[0], &tbuf[0], tlen)
    p[tlen] = 0
    next()
    if tok != T_EOS && tok != T_EOF { err("end of statement expected") }
    push_include(&p[0])
    if tok == T_EOS { next() }
}

// Skip a statement up to EOS outside brackets (the preliminary pass).
fn skip_stmt() {
    var d: uint = 0
    loop {
        var t = tok
        if t == T_EOF { return }
        if t == T_EOS && d == 0 { next(); return }
        if t == T_LPAREN || t == T_LBRACK || t == T_LBRACE { d++ }
        if (t == T_RPAREN || t == T_RBRACK || t == T_RBRACE) && d > 0 { d-- }
        next()
    }
}

fn decl_name(kind: uint): ptr Sym {
    if tok != T_IDENT { err("name expected") }
    check_name(&tbuf[0], tlen)
    if tlen == 4 && memeq(&tbuf[0], "args", 4) != 0 { err("reserved name: args") }
    if gfind(&tbuf[0], tlen) != 0 { err2("redeclared: ", &tbuf[0]) }
    var s = gadd(&tbuf[0], tlen, kind)
    s.decl = 1
    next()
    return s
}

fn tput_type(t: uint) {
    if tused >= TPOOL { err("too many functions") }
    tpool[tused] = byte(t)
    tused++
}

// ---- preliminary pass: global names, function signatures, constants (sect. 12.6) ---------
fn prepass() {
    loop {
        sused = 0
        if tok == T_EOF { break }
        if tok == T_EOS { next(); continue }
        if tok == T_INCLUDE { do_include(); decl_seen = 0; continue }
        decl_seen = 1
        if tok == T_CONST {
            next()
            var s = decl_name(S_CONST)
            expect(T_ASSIGN, "=")
            var k, a, b: uint
            k, a, b = const_value()
            s.ty = byte(k); s.a = a; s.b = b
            end_stmt()
            continue
        }
        if tok == T_VAR {
            next()
            var first = ngsym
            loop {
                if tok == T_IDENT && tlen == 1 && tbuf[0] == '_' { next() } else {
                    var s = decl_name(S_VAR)
                    s.a = nglob
                    nglob++
                }
                if tok != T_COMMA { break }
                next()
            }
            if tok == T_COLON {
                next()
                var ty = type_name()
                while first < ngsym { gsym[first].ty = byte(ty); first++ }
            }
            skip_stmt()
            continue
        }
        if tok == T_FN {
            next()
            if nfn >= FNMAX { err("too many functions") }
            var isn = uint(tlen == 4 && memeq(&tbuf[0], "main", 4) != 0)
            var mline = tline
            var mcol = tcol
            var nmp = &tbuf[0]
            fn_name[nfn] = kintern(nmp, tlen)
            var s = decl_name(S_FN)
            var f = nfn
            nfn++
            s.a = f
            fn_ty[f] = tused
            expect(T_LPAREN, "(")
            var np: uint = 0
            while tok == T_IDENT {
                next()
                var ty: uint = 0
                if tok == T_COLON { next(); ty = type_name() }
                tput_type(ty)
                np++
                if tok != T_COMMA { break }
                next()
            }
            expect(T_RPAREN, ")")
            if np > 16 { err("too many parameters") }
            var nr: uint = 0
            if tok == T_COLON {
                next()
                loop {
                    tput_type(type_name())
                    nr++
                    if tok != T_COMMA { break }
                    next()
                }
            }
            if nr > 8 { err("too many results") }
            fn_np[f] = byte(np)
            fn_nr[f] = byte(nr)
            var typed: uint = 0
            var i: uint = 0
            while i < np + nr {
                var ty = uint(tpool[fn_ty[f] + i])
                if ty != 0 && ty != TY_VALUE { typed = 1 }
                i++
            }
            fn_typed[f] = byte(typed)
            if isn != 0 {
                is_main = 1
                if np > 1 || nr > 1 || nr == 1 && tpool[fn_ty[f] + np] != TY_INT ||
                   np == 1 && tpool[fn_ty[f]] != TY_ARR && tpool[fn_ty[f]] != 0 {
                    err_at(tfile, mline, mcol, "invalid signature of main", 0)
                }
            }
            if tok != T_LBRACE { err("expected {") }
            var d: uint = 0
            loop {
                if tok == T_EOF { err("expected }") }
                if tok == T_LBRACE { d++ }
                if tok == T_RBRACE { d--; if d == 0 { next(); break } }
                next()
            }
            continue
        }
        skip_stmt()
    }
    close_all()
}

// ---- second pass: code ------------------------------------------------------------------------
fn program() {
    in_fn = 0
    nslot = 0
    maxslot = 0
    sdepth = 0
    nloop = 0
    loop {
        sused = 0
        if tok == T_EOF { break }
        if tok == T_EOS { next(); continue }
        if tok == T_INCLUDE { do_include(); decl_seen = 0; continue }
        decl_seen = 1
        if tok == T_FN { fn_decl(); continue }
        if tok == T_VAR { var_decl(); end_stmt(); continue }
        if tok == T_CONST { const_decl(); end_stmt(); continue }
        if is_main != 0 { err("statements are not allowed at top level of a program with main") }
        ign = stmt()
    }
    if is_main != 0 {
        var m = &gsym[gfind("main", 4) - 1]
        var f = m.a
        if fn_np[f] == 1 { op2w(OP_LDG, 0) }
        op2w(OP_CALL, f)
        if fn_nr[f] == 1 { emit(MODE_EXACT | 1); op1(OP_RET, 1) } else { emit(MODE_DISCARD); op1(OP_RET, 0) }
    } else {
        op1(OP_RET, 0)
    }
    fn_code[0] = 0
    fn_nl[0] = byte(maxslot)
    close_all()
}

// ---- writing .bsc (sect. 12.5) ----------------------------------------------------------------------
var ofd: uint
var opath: ptr byte

fn wr(p: ptr byte, n: uint) {
    var e, w: uint
    e, w = sys_write(ofd, p, n)
    if e != OK || w != n { fatal("", opath, e) }
}

fn wrw(v: uint) {
    var b: [2]byte
    b[0] = byte(v & $FF)
    b[1] = byte(v >> 8)
    wr(&b[0], 2)
}

var hdr: [HDR_SIZE / 2]uint

fn write_bsc(out: ptr byte) {
    var tmp: [PATHMAX]byte
    dir_of(&tmp[0], out)
    var n = strlen(&tmp[0])
    if n > 3 { tmp[n] = '/'; n++ }
    strcpy(&tmp[n], "~bsc.tmp")
    opath = &tmp[0]
    var e: uint
    e, ofd = sys_open(&tmp[0], O_WRITE | O_CREATE | O_TRUNC, 0)
    if e != OK { fatal("", &tmp[0], e) }
    // section sizes
    var srcsz: uint = 0
    var k: uint = 0
    while k < nfiles { srcsz += 5 + strlen(src_path(k)); k++ }
    var srcpad = srcsz & 1
    var funcsz = nfn * FN_ENTRY + tused
    var funcpad = funcsz & 1
    var codepad = cpos & 1
    hdr[0] = 'B' | 'S' << 8
    hdr[1] = 'C' | '1' << 8
    hdr[H_VERSION / 2] = BSC_VERSION
    hdr[H_FLAGS / 2] = 0
    hdr[H_ENTRY / 2] = 0
    hdr[H_NGLOB / 2] = nglob
    hdr[H_NFILES / 2] = nfiles
    hdr[H_SRCSZ / 2] = srcsz + srcpad
    hdr[H_NCONST / 2] = nconst
    hdr[H_CONSTSZ / 2] = kused
    hdr[H_NFUNC / 2] = nfn
    hdr[H_FUNCSZ / 2] = funcsz + funcpad
    hdr[H_CODESZ / 2] = cpos + codepad
    hdr[H_LINESZ / 2] = lused
    wr(ptr byte(&hdr[0]), HDR_SIZE)
    // source table: MTIME (4 bytes), path length, path
    k = 0
    while k < nfiles {
        var mt = srcmt[k]
        wrw(uint(mt)); wrw(uint(mt >> 16))
        var p = src_path(k)
        var l = strlen(p)
        var b: [2]byte
        b[0] = byte(l)
        wr(&b[0], 1)
        wr(p, l)
        k++
    }
    var z: [2]byte
    z[0] = 0; z[1] = 0
    if srcpad != 0 { wr(&z[0], 1) }
    xfile(XB_KONST, kused)
    // functions
    k = 0
    while k < nfn {
        wrw(fn_name[k])
        wrw(fn_code[k])
        var b: [4]byte
        b[0] = fn_np[k]; b[1] = fn_nl[k]; b[2] = fn_nr[k]; b[3] = fn_typed[k]
        wr(&b[0], 4)
        wrw(fn_ty[k])
        k++
    }
    wr(&tpool[0], tused)
    if funcpad != 0 { wr(&z[0], 1) }
    xfile(XB_CODE, cpos)
    if codepad != 0 { wr(&z[0], 1) }
    lt_flush()
    xfile(XB_LINES, lused)
    e = sys_close(ofd)
    if e != OK { fatal("", &tmp[0], e) }
    e = sys_delete(out)
    e = sys_rename(&tmp[0], out)
    if e != OK { e = sys_delete(&tmp[0]); fatal("", out, e) }
}

// ---- command line -------------------------------------------------------------------------
fn usage(): int {
    fputs(STDERR, "usage: bsc [-l] source.bs [-o out.bsc]\n       bsc --run cache.bsc source.bs [args...]\n")
    return 2
}

// the --run command line: in the scratch area, free by this point
var cmdline: ptr byte = &scratch[0]

fn cl_add(len: uint, s: ptr byte): uint {
    var q: uint = 0
    if *s == 0 { q = 1 }
    var t = s
    while *t != 0 {
        if *t == ' ' || *t == 9 { q = 1 }
        if *t == '"' { return $FFFF }
        t++
    }
    if len != 0 { if len >= 255 { return $FFFF }; cmdline[len] = ' '; len++ }
    if q != 0 { if len >= 255 { return $FFFF }; cmdline[len] = '"'; len++ }
    while *s != 0 {
        if len >= 255 { return $FFFF }
        cmdline[len] = *s; len++; s++
    }
    if q != 0 { if len >= 255 { return $FFFF }; cmdline[len] = '"'; len++ }
    cmdline[len] = 0
    return len
}

fn compile(src: ptr byte) {
    var abs: [PATHMAX]byte
    if make_abs(&abs[0], &cwd[0], src) == 0 { fatal("invalid path", src, 0) }
    var st: Stat
    var e = sys_stat(&abs[0], &st)
    if e != OK { fatal("", src, e) }
    ign = kintern("", 0)
    fn_name[0] = 0
    fn_np[0] = 0
    fn_nr[0] = 0
    fn_ty[0] = 0
    nfn = 1
    nglob = 1
    start_pass(&abs[0])
    prepass()
    var k: uint = 0
    while k < ngsym { gsym[k].decl = 0; k++ }
    cpos = 0
    lused = 0
    lt_flushed = 0
    lt_any = 0
    decl_seen = 0
    start_pass(&abs[0])
    program()
}

fn main(argc: uint, argv: ptr ptr byte): int {
    stack_limit = PIB_ARGS_END + 768
    lex_init()
    bi_init()
    var e, n: uint
    e, n = sys_getcwd(&cwd[0], PATHMAX)
    if e != OK { fatal("", "cwd", e) }
    var src: ptr byte = 0
    var out: ptr byte = 0
    var listing: uint = 0
    var run: uint = 0
    var i: uint = 1
    if argc >= 2 && streq(argv[1], "--run") != 0 {
        if argc < 4 { return usage() }
        run = 1
        out = argv[2]
        src = argv[3]
        i = argc
    }
    while i < argc {
        var a = argv[i]
        if streq(a, "-l") != 0 { listing = 1 }
        else if streq(a, "-o") != 0 {
            i++
            if i >= argc { return usage() }
            out = argv[i]
        }
        else if a[0] == '-' { return usage() }
        else if src != 0 { return usage() }
        else { src = a }
        i++
    }
    if src == 0 { return usage() }
    compile(src)
    var outp: [PATHMAX]byte
    if out == 0 {
        // source.bsc next to the source: .bs -> .bsc, otherwise + .bsc
        strcpy(&outp[0], src)
        var l = strlen(&outp[0])
        if l >= 3 && outp[l - 3] == '.' && chfold(outp[l - 2]) == 'b' && chfold(outp[l - 1]) == 's' {
            outp[l] = 'c'; outp[l + 1] = 0
        } else {
            if l + 5 >= PATHMAX { fatal("path too long", src, 0) }
            strcpy(&outp[l], ".bsc")
        }
    } else {
        if strlen(out) >= PATHMAX { fatal("path too long", out, 0) }
        strcpy(&outp[0], out)
    }
    var oabs: [PATHMAX]byte
    if make_abs(&oabs[0], &cwd[0], &outp[0]) == 0 { fatal("invalid path", &outp[0], 0) }
    write_bsc(&oabs[0])
    if listing != 0 { list_code() }
    if run != 0 {
        var len = cl_add(0, "A:/bin/bsvm.cx")
        len = cl_add(len, &oabs[0])
        if len != $FFFF { len = cl_add(len, src) }
        i = 4
        while i < argc && len != $FFFF { len = cl_add(len, argv[i]); i++ }
        if len == $FFFF { fatal("", "bsvm", E_ARGS) }
        e = sys_exec(&cmdline[0])
        fatal("", "A:/bin/bsvm.cx", e)
    }
    return 0
}
