// ops.b16 - bytecode commands ("BScript Bytecode Format", sect. 3).

fn op_bad() { rt_err("bad instruction") }
fn op_null() { push(TAG_NULL, 0) }
fn op_true() { push(TAG_BOOL, 1) }
fn op_false() { push(TAG_BOOL, 0) }
fn op_int8() {
    var d = vsp
    if d >= vlim { rt_err("stack overflow") }
    d.t = TAG_INT
    d.v = uint(int(char(*ip)))
    ip++
    vsp = d + 1
}
fn op_int16() { push(TAG_INT, rd16()) }
fn op_str() { push(TAG_STR, konst[rd16()]) }
fn op_ldl() {
    var d = vsp
    if d >= vlim { rt_err("stack overflow") }
    var s = fbase + uint(*ip)
    ip++
    d.t = s.t; d.v = s.v
    vsp = d + 1
}
fn op_stl() {
    var d = fbase + uint(*ip)
    ip++
    var v = vsp - 1
    vsp = v
    d.t = v.t; d.v = v.v
}
fn op_ldg() {
    var d = vsp
    if d >= vlim { rt_err("stack overflow") }
    var s = glob + rd16()
    d.t = s.t; d.v = s.v
    vsp = d + 1
}
fn op_stg() {
    var d = glob + rd16()
    var v = vsp - 1
    vsp = v
    d.t = v.t; d.v = v.v
}
fn op_pop() { vsp-- }
fn op_dup() { var s = vsp - 1; push(s.t, s.v) }
fn op_dup2() {
    var s = vsp - 2
    push(s.t, s.v)
    s = vsp - 2
    push(s.t, s.v)
}
fn op_popn() { vsp -= rd8() }
fn op_chkt() { chk_type(vsp - 1, rd8()) }

// ---- arithmetic (sect. 4.2) ----------------------------------------------------------------------
fn ints2(name: ptr byte): ptr Val {
    var a = vsp - 2
    var b = vsp - 1
    if a.t != TAG_INT { type_err(name, a) }
    if b.t != TAG_INT { type_err(name, b) }
    vsp = b
    return a
}

fn op_add() {
    var a = vsp - 2
    var b = vsp - 1
    if a.t == TAG_INT && b.t == TAG_INT { a.v += b.v; vsp = b; return }
    if a.t == TAG_STR && b.t == TAG_STR {
        var la = slen(a.v)
        var lb = slen(b.v)
        if la + lb > 32767 { rt_err("too large") }
        var h = new_str(la + lb)
        a = vsp - 2
        b = vsp - 1
        hmove(h, 0, a.v, 0, la)
        hmove(h, la, b.v, 0, lb)
        a.v = h
        vsp = b
        return
    }
    if a.t != TAG_INT && a.t != TAG_STR { type_err("bad operand for +: ", a) }
    type_err("bad operand for +: ", b)
}
fn op_sub() { var a = ints2("bad operand for -: "); a.v -= vsp.v }
fn op_mul() { var a = ints2("bad operand for *: "); a.v *= vsp.v }
fn op_div() {
    var a = ints2("bad operand for /: ")
    var y = int(vsp.v)
    if y == 0 { rt_err("division by zero") }
    if a.v == $8000 && y == -1 { return }
    a.v = uint(int(a.v) / y)
}
fn op_mod() {
    var a = ints2("bad operand for %: ")
    var y = int(vsp.v)
    if y == 0 { rt_err("division by zero") }
    if y == -1 { a.v = 0; return }
    a.v = uint(int(a.v) % y)
}
fn op_and() { var a = ints2("bad operand for &: "); a.v &= vsp.v }
fn op_or() { var a = ints2("bad operand for |: "); a.v |= vsp.v }
fn op_xor() { var a = ints2("bad operand for ^: "); a.v ^= vsp.v }
fn shift_n(): uint {
    if int(vsp.v) < 0 { rt_err("negative shift count") }
    return vsp.v
}
fn op_shl() {
    var a = ints2("bad operand for <<: ")
    var n = shift_n()
    if n >= 16 { a.v = 0 } else { a.v <<= n }
}
fn op_shr() {
    var a = ints2("bad operand for >>: ")
    var n = shift_n()
    if n >= 16 { n = 15 }
    a.v = uint(int(a.v) >> n)
}
fn op_ushr() {
    var a = ints2("bad operand for >>>: ")
    var n = shift_n()
    if n >= 16 { a.v = 0 } else { a.v >>= n }
}
fn int1(name: ptr byte): ptr Val {
    var a = vsp - 1
    if a.t != TAG_INT { type_err(name, a) }
    return a
}
fn op_neg() { var a = int1("bad operand for -: "); a.v = 0 - a.v }
fn op_bnot() { var a = int1("bad operand for ~: "); a.v = ~a.v }
fn op_pos() { ign = uint(int1("bad operand for +: ")) }
fn op_not() {
    var a = vsp - 1
    if a.t != TAG_BOOL { type_err("bool expected, got ", a) }
    a.v ^= 1
}

// ---- comparisons (sect. 4.4) -------------------------------------------------------------------------
fn op_eq() { var a = vsp - 2; a.v = veq(a, vsp - 1); a.t = TAG_BOOL; vsp-- }
fn op_ne() { var a = vsp - 2; a.v = veq(a, vsp - 1) ^ 1; a.t = TAG_BOOL; vsp-- }

fn cmp2(): int {
    var a = vsp - 2
    var b = vsp - 1
    var r: int = 0
    if a.t == TAG_INT && b.t == TAG_INT {
        vsp = b
        a.t = TAG_BOOL
        if int(a.v) < int(b.v) { return -1 }
        if int(a.v) > int(b.v) { return 1 }
        return 0
    }
    if a.t == TAG_INT && b.t == TAG_INT {
        if int(a.v) < int(b.v) { r = -1 } else if int(a.v) > int(b.v) { r = 1 }
    } else if a.t == TAG_STR && b.t == TAG_STR {
        r = str_order(a.v, b.v)
    } else {
        if a.t != TAG_INT && a.t != TAG_STR { type_err("cannot compare ", a) }
        type_err("cannot compare ", b)
    }
    vsp = b
    a.t = TAG_BOOL
    return r
}
fn op_lt() { var r = cmp2(); (vsp - 1).v = uint(r < 0) }
fn op_le() { var r = cmp2(); (vsp - 1).v = uint(r <= 0) }
fn op_gt() { var r = cmp2(); (vsp - 1).v = uint(r > 0) }
fn op_ge() { var r = cmp2(); (vsp - 1).v = uint(r >= 0) }

fn arr_index(h: uint, v: ptr Val): uint {
    var n = alen(h)
    var e: Val
    var i: uint = 0
    while i < n {
        e.t, e.v = aget(h, i)
        if veq(&e, v) != 0 { return i }
        i++
    }
    return $FFFF
}

fn op_in() {
    var a = vsp - 2
    var b = vsp - 1
    var r: uint = 0
    if b.t == TAG_ARR { r = uint(arr_index(b.v, a) != $FFFF) }
    else if b.t == TAG_MAP {
        if a.t != TAG_STR { type_err("map key must be a string, got ", a) }
        r = uint(map_find(b.v, a.v) != 0)
    } else if b.t == TAG_STR {
        if a.t != TAG_STR { type_err("string expected, got ", a) }
        r = uint(hfind(b.v, a.v, 0) != $FFFF)
    } else { type_err("bad operand for in: ", b) }
    a.t = TAG_BOOL
    a.v = r
    vsp = b
}

// ---- jumps ------------------------------------------------------------------------------------
fn jmp_rel() {
    var p = ip
    var t = uint(p) + 2 + (uint(p[0]) | uint(p[1]) << 8)
    if cf_multi != 0 && (t < OV_BASE || t >= OV_BASE + $2000) {
        ip = code_at((cf_cur << 13) + t - OV_BASE)        // a jump to another code frame
        return
    }
    ip = ptr byte(t)
}
fn bool_top(): uint {
    var a = vsp - 1
    if a.t != TAG_BOOL { type_err("bool expected, got ", a) }
    return a.v
}
fn op_jmp() {
    jmp_rel()
    if promote_pending != 0 { ign = g_promote() }        // safe point: a backward jump in a loop
}
fn op_jf() {
    var a = vsp - 1
    vsp = a
    if a.t != TAG_BOOL { type_err("bool expected, got ", a) }
    if a.v == 0 { jmp_rel() } else { ip += 2 }
}
fn op_jt() { var c = bool_top(); vsp--; if c != 0 { jmp_rel() } else { ip += 2 } }
fn op_jfk() { if bool_top() == 0 { jmp_rel() } else { vsp--; ip += 2 } }
fn op_jtk() { if bool_top() != 0 { jmp_rel() } else { vsp--; ip += 2 } }
fn op_jnn() { if (vsp - 1).t != TAG_NULL { jmp_rel() } else { vsp--; ip += 2 } }
fn op_chkb() { ign = bool_top() }

// ---- fail and errors -----------------------------------------------------------------------------
fn op_errc() {
    var c = rd8()
    var t = code_text(c)
    push(TAG_ERR, new_err(c, t, 0, $FFFF))
}

// fail: the error is built by the gc overlay; the frames are popped here, when the window holds the module frame again
fn op_fail() {
    ga_a = rd8()
    ga_b = cur_pc() - 1
    ign = g_fail()
    fail_current()
}

// ---- indexes -----------------------------------------------------------------------------------
fn index_of(v: ptr Val, n: uint): uint {
    if v.t != TAG_INT { type_err("index must be int, got ", v) }
    if v.v >= n { rt_err("index out of range") }
    return v.v
}

fn op_getidx() {
    var c = vsp - 2
    var i = vsp - 1
    vsp = i
    if c.t == TAG_ARR {
        var k = index_of(i, alen(c.v))
        c.t, c.v = aget(c.v, k)
        return
    }
    if c.t == TAG_STR {
        var k = index_of(i, slen(c.v))
        c.v = hgb(c.v, k)
        c.t = TAG_INT
        return
    }
    if c.t == TAG_MAP {
        if i.t != TAG_STR { type_err("map key must be a string, got ", i) }
        var t, v: uint
        t, v = map_get(c.v, i.v)
        if t == 0 { t = TAG_NULL }
        c.t = t
        c.v = v
        return
    }
    type_err("cannot index ", c)
}

// c[i] = v, all three are on the stack
fn set_elem(c: ptr Val, i: ptr Val, v: ptr Val) {
    if c.t == TAG_ARR {
        aput(c.v, index_of(i, alen(c.v)), v.t, v.v)
        return
    }
    if c.t == TAG_MAP {
        if i.t != TAG_STR { type_err("map key must be a string, got ", i) }
        map_set(c.v, i.v, v.t, v.v)
        return
    }
    if c.t == TAG_STR { rt_err("strings are immutable") }
    type_err("cannot index ", c)
}

fn op_setidx() {
    set_elem(vsp - 3, vsp - 2, vsp - 1)
    vsp -= 3
}

fn op_setidxd() {
    var d = rd8()
    var v = vsp - 1
    set_elem(v - d - 2, v - d - 1, v)
    vsp = v
}

// ---- literals, concatenation -------------------------------------------------------------------------
fn op_arr() {
    var n = rd16()
    var h = new_arr(n)
    var s = vsp - n
    aput_n(h, 0, s, n)
    aset_len(h, n)
    vsp = s
    push(TAG_ARR, h)
}

fn op_map() {
    var n = rd16()
    var h = new_map(n)
    tpush(h)
    var s = vsp - 2 * n
    var i: uint = 0
    while i < n {
        var k = s + 2 * i
        if k.t != TAG_STR { type_err("map key must be a string, got ", k) }
        map_set(h, k.v, (k + 1).t, (k + 1).v)
        i++
    }
    ntr = 0
    vsp = s
    push(TAG_MAP, h)
}

fn op_concat() {
    var n = rd8()
    var s = vsp - n
    var total: uint = 0
    var i: uint = 0
    while i < n {
        var p = s + i
        if p.t != TAG_STR { p.v = to_str(p); p.t = TAG_STR }
        total += slen(p.v)
        if total > 32767 { rt_err("too large") }
        i++
    }
    var h = new_str(total)
    var d: uint = 0
    i = 0
    while i < n {
        var p = s + i
        var l = slen(p.v)
        hmove(h, d, p.v, 0, l)
        d += l
        i++
    }
    vsp = s
    push(TAG_STR, h)
}

// ---- for --------------------------------------------------------------------------------------
fn op_forinit() {
    var s = fbase + rd8()
    vsp--
    var c = vsp
    var n: uint
    if c.t == TAG_ARR { n = alen(c.v) }
    else if c.t == TAG_STR { n = slen(c.v) }
    else { type_err("cannot iterate over ", c); n = 0 }
    s.t = c.t; s.v = c.v
    s[1].t = TAG_INT; s[1].v = 0
    s[2].t = TAG_INT; s[2].v = n
}

fn fornext(two: uint) {
    var s = fbase + rd8()
    var i = s[1].v
    if i >= s[2].v { jmp_rel(); return }
    ip += 2
    if two != 0 { push(TAG_INT, i) }
    if s.t == TAG_ARR {
        if alen(s.v) != s[2].v { rt_err("array changed during iteration") }
        var t, v: uint
        t, v = aget(s.v, i)
        push(t, v)
    } else {
        push(TAG_INT, hgb(s.v, i))
    }
    s[1].v = i + 1
}
fn op_fornext1() { fornext(0) }
fn op_fornext2() { fornext(1) }

var ops: [OP_LAST + 1]ptr fn() = {
    op_bad, op_null, op_true, op_false, op_int8, op_int16, op_str, op_ldl, op_stl, op_ldg,
    op_stg, op_pop, op_dup, op_dup2, op_popn, op_chkt, op_add, op_sub, op_mul, op_div,
    op_mod, op_and, op_or, op_xor, op_shl, op_shr, op_ushr, op_neg, op_not, op_bnot,
    op_pos, op_bad, op_eq, op_ne, op_lt, op_le, op_gt, op_ge, op_in, op_bad,
    op_jmp, op_jf, op_jt, op_jfk, op_jtk, op_jnn, op_chkb, op_bad, op_call, op_callb,
    op_callm, op_ret, op_fail, op_errc, op_bad, op_bad, op_getidx, op_setidx, op_setidxd, op_arr,
    op_map, op_concat, op_forinit, op_fornext1, op_fornext2 }

fn run() {
    loop {
        var p = ip
        var o = uint(*p)
        ip = p + 1
        if o > OP_LAST { op_bad() }
        ops[o]()
    }
}
