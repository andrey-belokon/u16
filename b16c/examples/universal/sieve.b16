// sieve.b16 - the Sieve of Eratosthenes: a byte array, nested loops, constants.
include "../../lib/io.b16"

const N = 2000
var composite: [N]byte          // a global array, zeroed on load

fn main() {
    var count: uint = 0
    var i: uint = 2
    while i < N {
        if composite[i] == 0 {
            count++
            if count <= 20 { putu(i); putc(' ') }
            var j = i * i
            if j / i == i {                 // i*i did not overflow
                while j < N { composite[j] = 1; j += i }
            }
        }
        i++
    }
    puts("...\nprimes below "); putu(N); puts(": "); putu(count); putnl()
}
