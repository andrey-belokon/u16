// A function with results must not reach the end of its body without a return (sect. 7.7).
// Code generation errors are also reported for unreachable functions.
fn noret(x: int): int {
    if x > 0 { return 1 }
}
fn loops(): int { loop { } }
fn viagoto(x: int): int {
again:
    if x > 0 { return 1 }
    x++
    goto again
}
fn ifelse(x: int): int {
    if x > 0 { return 1 } else { return 2 }
}
fn whileend(x: int): int {
    while x > 0 { return 1 }
}
fn main() { }
