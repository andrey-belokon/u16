// Function results in parentheses (sect. 4.5, 5.5): a single type and a list are allowed, empty
// and unbalanced parentheses are not.
fn ok1(): (int) { return 1 }
fn ok2(): (int, uint) { return 1, 2 }
fn bad1(): () { }
fn bad2(): (int { return 1 }
fn bad3(): int) { return 1 }
fn bad4(): (int, int, int, int, int) { return 1, 2, 3, 4, 5 }
fn main() { }
