var OUT at $FF20: byte
var fails: uint
var checks: uint

fn putc(c: byte) { OUT = c }
fn puts(s: ptr byte) { while *s != 0 { putc(*s++) } }
fn putu(v: uint) {
    var b: [6]byte
    var i: uint = 0
    loop { b[i++] = byte(v % 10) + '0'; v /= 10; if v == 0 { break } }
    while i != 0 { putc(b[--i]) }
}
fn puti(v: int) { if v < 0 { putc('-'); v = -v }; putu(uint(v)) }

fn check(id: uint, got: int, want: int) {
    checks++
    if got != want {
        fails++
        puts("FAIL #"); putu(id); puts(": got "); puti(got); puts(" want "); puti(want); putc(10)
    }
}

// ---------- test helper functions ----------
fn add3(a, b, c: int): int { return a + b + c }
fn rot3(a, b, c: int): int, int, int { return b, c, a }
fn four(): int, int, int, int { return 1, 2, 3, 4 }
fn swap4(a, b, c, d: int): int, int, int, int { return d, c, b, a }
fn eight(a, b, c, d, e, f, g, h: int): int { return a - b + c - d + e - f + g - h }
fn fact(n: uint): uint { if n <= 1 { return 1 }; return n * fact(n - 1) }
fn apply(f: ptr fn(int): int, x: int): int { return f(x) }
fn dbl(x: int): int { return x * 2 }
fn neg(x: int): int { return -x }

struct Pt { x, y: int; tag: byte; z: int }
var pts: [4]Pt
var words: [8]int = {1, 2, 3, 4, 5, 6, 7, 8}
var bytes: [8]byte = {250, 251, 252, 253, 254, 255, 0, 1}
var chars: [4]char = {-1, -128, 127, 5}
var gb: byte
var gc: char
var gw: int = 1000
var fptr: ptr fn(int): int
var lock: byte

fn many_locals(n: int): int {
    var a = n + 1
    var b = n + 2
    var c = n + 3
    var d = n + 4
    var e = n + 5
    var f = n + 6
    var g = n + 7
    var h = n + 8
    var i = n + 9
    var j = n + 10
    var k = n + 11
    putc(0)    // makes the function non-leaf
    return a + b + c + d + e + f + g + h + i + j + k
}

fn leaf_many(n: int): int {
    var a = n + 1
    var b = n + 2
    var c = n + 3
    var d = n + 4
    var e = n + 5
    var f = n + 6
    var g = n + 7
    var h = n + 8
    var i = n + 9
    var j = n + 10
    var k = n + 11
    return a * b - c * d + e * f - g * h + i * j - k
}

fn addr_local(): int {
    var x: int = 5
    var p = &x
    *p += 10
    return x
}

fn sum_words(p: ptr int, n: uint): int {
    var s: int = 0
    while n != 0 { s += *p++; n-- }
    return s
}

fn rev_words(p: ptr int, n: uint) {
    var q = p + n
    while p < q { q--; var t = *p; *p = *q; *q = t; p++ }
}

fn count_ones(x: uint): uint {
    var n: uint = 0
    while x != 0 { n += x & 1; x >>= 1 }
    return n
}

fn classify(x: int): int {
    if x < -10 { return 1 } else if x < 0 { return 2 } else if x == 0 { return 3 } else if x <= 10 { return 4 }
    return 5
}

fn skip_odd(n: uint): uint {
    var s: uint = 0
    var i: uint = 0
    while i < n {
        i++
        if i & 1 { continue }
        s += i
    }
    return s
}

fn atomic_break(): uint {
    var i: uint = 0
    loop {
        atomic {
            i++
            if i == 3 { break }
        }
    }
    return i
}

fn long_jump(x: uint): uint {
    var s: uint = 0
    while x != 0 {
        s += x; s += x; s += x; s += x; s += x; s += x; s += x; s += x; s += x; s += x
        s += x; s += x; s += x; s += x; s += x; s += x; s += x; s += x; s += x; s += x
        s += x; s += x; s += x; s += x; s += x; s += x; s += x; s += x; s += x; s += x
        s += x; s += x; s += x; s += x; s += x; s += x; s += x; s += x; s += x; s += x
        s ^= gw; s ^= gw; s ^= gw; s ^= gw; s ^= gw; s ^= gw; s ^= gw; s ^= gw
        x--
    }
    return s
}

fn nested(a, b: int): int { return add3(a, add3(b, 1, 2), add3(a, b, add3(1, 1, 1))) }

fn mixed(a: int, b: uint): int { return a * 3 + int(b >> 1) - (a & 7) }

fn stack_args_addr(_a, _b, _c, _d, e, f: int): int {
    var p = &e
    return *p + f
}

fn main() {
    check(1, add3(1, 2, 3), 6)
    var x, y, z: int
    x, y, z = rot3(1, 2, 3)
    check(2, x * 100 + y * 10 + z, 231)
    var a, b, c, d: int
    a, b, c, d = four()
    check(3, a + b * 10 + c * 100 + d * 1000, 4321)
    a, b, c, d = swap4(1, 2, 3, 4)
    check(4, a + b * 10 + c * 100 + d * 1000, 1234)
    check(5, eight(1, 2, 3, 4, 5, 6, 7, 8), -4)
    check(6, int(fact(7)), 5040)
    check(7, apply(dbl, 21), 42)
    fptr = neg
    check(8, fptr(9), -9)
    check(9, apply(fptr, -3), 3)
    pts[2].x = 7; pts[2].y = -8; pts[2].tag = 200; pts[2].z = 99
    var pp = &pts[2]
    check(10, pp.x + pp.y + pp.z, 98)
    check(11, int(pp.tag), 200)
    check(12, sizeof(Pt), 8)
    check(13, sum_words(&words[0], 8), 36)
    rev_words(&words[0], 8)
    check(14, words[0] * 10 + words[7], 81)
    check(15, int(bytes[1]) + int(bytes[7]), 252)
    check(16, int(chars[0]) + int(chars[1]), -129)
    check(17, chars[0] < 0, 1)
    check(18, bytes[0] > 200, 1)
    gb = 255; gb += 2
    check(19, int(gb), 1)
    gc = 127; gc++
    check(20, int(gc), -128)
    check(21, many_locals(1), 77)
    check(22, leaf_many(0), 2*1 - 3*4 + 5*6 - 7*8 + 9*10 - 11)
    check(23, addr_local(), 15)
    check(24, int(count_ones($F0F1)), 9)
    check(25, classify(-20) * 10000 + classify(-5) * 1000 + classify(0) * 100 + classify(7) * 10 + classify(50), 12345)
    check(26, int(skip_odd(10)), 30)
    check(27, int(atomic_break()), 3)
    check(28, int(long_jump(3)), int((3 + 2 + 1) * 40))
    check(29, nested(1, 2), 1 + 5 + 6)
    check(30, mixed(-5, 9), -15 + 4 - 3)
    var m: int = -7
    check(31, m / 2, -3)
    check(32, m % 2, -1)
    m /= 2
    check(33, m, -3)
    var u: uint = 65535
    check(34, int(u / 255), 257)
    check(35, int(u >> 15), 1)
    check(36, m >> 1, -2)
    check(37, (x > 1) + (y > 1) * 2, 3)
    check(38, (x == 2 && y == 3) || z == 0, 1)
    check(39, !(x == 2), 0)
    check(40, ~0, -1)
    lock = 0
    var old = xchb(&lock, 1)
    check(41, int(old) * 10 + int(lock), 1)
    check(42, int(ror(1, 1)), int($8000))
    check(43, int(mulhu($8000, 4)), 2)
    check(44, stack_args_addr(1, 2, 3, 4, 5, 6), 11)
    var s: ptr byte = "abc"
    var n: uint = 0
    while *s++ { n++ }
    check(45, int(n), 3)
    var q: ptr int = &words[0]
    q += 3
    check(46, *q, 5)
    check(47, int(q - &words[0]), 3)
    q[1] = 77
    check(48, words[4], 77)
    var i: uint = 2
    words[i * 2] = -1
    check(49, words[4], -1)
    bytes[i] = 9
    check(50, int(bytes[2]), 9)
    pts[i].z += 1
    check(51, pts[2].z, 100)
    var k: int = 3
    k = k * k + k
    check(52, k, 12)
    k = 100 - k
    check(53, k, 88)
    if checks == 53 && fails == 0 { puts("ALL OK\n") } else { puts("checks="); putu(checks); puts(" fails="); putu(fails); putc(10) }
}
