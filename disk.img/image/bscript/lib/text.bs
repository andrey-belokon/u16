// text.bs - common functions of the examples: included with the include directive.

// A number right-aligned in a field of width w.
fn rjust(n: int, w: int): string {
    return str(n).pad_left(w)
}

// The words of a line: the parts between spaces and tabs, empty parts are skipped.
fn words(line: string): array {
    var out = []
    var cur = ""
    for c in line + " " {
        if c == ' ' || c == '\t' || c == '\r' {
            if cur != "" {
                out.push(cur)
                cur = ""
            }
        } else {
            cur += str.from_byte(c)
        }
    }
    return out
}

// An error message in the utilities' format: "name: text" to stream 2.
fn warn(msg: value) {
    eprintln($"{|proc.name()|}: {|msg|}")
}
