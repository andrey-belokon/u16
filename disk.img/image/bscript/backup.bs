// run: bs /ex/backup.bs /ex/data /tmp/bak ; bs /ex/backup.bs /ex/data /tmp/bak ; ls /tmp/bak
// backup.bs - a copy of a directory with subdirectories; a repeated run copies only new files.
//
//   backup source destination
//
// A program with main: functions, recursion, intercepting errors by code (errors.EXIST),
// an error with the program's own code (1000).

const E_USAGE = 1000

var copied = 0
var skipped = 0

fn ensure_dir(p: string) {
    var err = fs.mkdir(p)
    if err != null && err != errors.EXIST {
        fail err
    }
}

fn copy_tree(src: string, dst: string) {
    ensure_dir(dst)
    for e in fs.list(src) {
        var s = path.join(src, e["name"])
        var d = path.join(dst, e["name"])
        if e["dir"] {
            copy_tree(s, d)
        } else if fs.exists(d) {
            skipped++
        } else {
            fs.copy(s, d)
            copied++
        }
    }
}

fn check_args(args: array) {
    if args.len() != 2 {
        fail "usage: backup source destination", null, E_USAGE
    }
    if !fs.is_dir(args[0]) {
        fail errors.NOTDIR, args[0]
    }
    if path.equal(args[0], args[1]) {
        fail "source and destination are the same", args[1]
    }
}

fn main(args: array): int {
    var err = check_args(args)
    if err != null {
        eprintln($"backup: {|err|}")
        if err.code() == E_USAGE { return 2 }
        return 1
    }
    copy_tree(args[0], args[1])          // other errors - the message and code 1 come by themselves
    println($"copied {|copied|}, skipped {|skipped|}")
    return 0
}
