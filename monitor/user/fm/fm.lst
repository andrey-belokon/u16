                                                                                         ; startup code
                                                                                         __start:
001C  0205 0006                                                                          	LD    R4, [$0006]	; "CXPB" - monitor, "CX16" - bare machine
0020  8273 4250                                                                          	CMP   R4, #$4250	; "PB"
0024  309E                                                                               	JZ    @monitor
0026  06F3 FF00                                                                          	LD    SP, #$FF00	; bare machine: its own stack
002A  0173 006A                                                                          	LD    R2, #__fault	; ERRCMD first of all
002E  2105 FF10                                                                          	ST    [$FF10], R2
0032  01F3 0078                                                                          	LD    R3, #__irq_ignore	; the other vectors - to an empty stub
0036  0173 FF00                                                                          	LD    R2, #$FF00
                                                                                         @vec:
003A  8173 FF10                                                                          	CMP   R2, #$FF10
003E  3081                                                                               	JZ    @skip
0040  2192                                                                               	ST    [R2], R3
                                                                                         @skip:
0042  4111                                                                               	ADD   R2, #2
0044  8173 FF20                                                                          	CMP   R2, #$FF20
0048  3178                                                                               	JNZ   @vec
004A  0173 5DEA                                                                          	LD    R2, #__bss_start	; bss: memory after reset is undefined
004E  0181                                                                               	LD    R3, #0
                                                                                         @bss:
0050  8173 8F6E                                                                          	CMP   R2, #__bss_end
0054  3082                                                                               	JZ    @args
0056  2193                                                                               	ST    [R2++], R3
0058  307B                                                                               	JMP   @bss
                                                                                         @args:
005A  0001                                                                               	LD    R0, #0		; argc = 0, argv = 0
005C  0081                                                                               	LD    R1, #0
005E  0673 006A                                                                          	LD    LR, #__halt	; return from main - halt
                                                                                         @monitor:			; monitor: R0 = argc, R1 = argv, SP = top, LR - exit
0062  266C                                                                               	PUSH  LR
0064  D077 4E02                                                                          	CALL  main
0068  076B                                                                               	POP   IP
                                                                                         
                                                                                         ; bare machine: halt after main and on ERRCMD
                                                                                         __fault:
                                                                                         __halt:
006A  0081                                                                               	LD    R1, #0
006C  2885 FF29                                                                          	STB   [$FF29], R1	; timer off
0070  6FC1                                                                               	STI			; accept a pending timer request (the __irq_ignore handler):
0072  67B9                                                                               	CLI			; otherwise WFI with IF = 0 wakes on it again and again
                                                                                         @stop:
0074  B020                                                                               	WFI
0076  307E                                                                               	JMP   @stop
                                                                                         
