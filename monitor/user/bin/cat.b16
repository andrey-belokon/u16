// cat [file ...] - the contents of files one after another; without arguments - standard input.
include "ulib.b16"
option max_top = $6000         // 24 KB is enough for the utility ("Shell", sect. 8.1)

var buf: [4096]byte

fn copy(h: uint, name: ptr byte): uint {
    loop {
        var e, n, w: uint
        e, n = sys_read(h, &buf[0], 4096)
        if e == E_INTR { return 1 }
        if e != OK { fail(name, e); return 1 }
        if n == 0 { return 0 }
        e, w = sys_write(STDOUT, &buf[0], n)
        if e != OK { fail("output", e); return 1 }
    }
}

fn main(argc: uint, argv: ptr ptr byte): int {
    prog = "cat"
    if argc < 2 { return int(copy(STDIN, "input")) }
    var bad: uint = 0
    var i: uint = 1
    while i < argc {
        var e, h: uint
        e, h = sys_open(argv[i], O_READ, 0)
        if e != OK { fail(argv[i], e); bad = 1 } else {
            bad |= copy(h, argv[i])
            e = sys_close(h)
        }
        i++
    }
    return int(bad)
}
