// mkdir directory ... - create directories.
include "ulib.b16"
option max_top = $6000         // 24 KB is enough for the utility ("Shell", sect. 8.1)

fn main(argc: uint, argv: ptr ptr byte): int {
    prog = "mkdir"
    if argc < 2 { return usage("dir ...") }
    var bad: uint = 0
    var i: uint = 1
    while i < argc {
        var e: uint = sys_mkdir(argv[i])
        if e != OK { fail(argv[i], e); bad = 1 }
        i++
    }
    return int(bad)
}
