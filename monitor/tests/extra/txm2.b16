// txm2.b16 - a check of the XMAP fast path and the main copy of the map RES.cmap (a shell script).
// Roles: no arguments - the parent; with F - a child; x - EXEC into y H; y H; brk - an XMAP loop until Ctrl+C
// with a handler; spin - an XMAP loop until Ctrl+C without a handler; bench N - N pairs of XMAP.
include "tlib.b16"
include asm "txm2.asm"
include "ulib.b16"

extern fn t_xregs(page: uint, f: uint): uint
extern fn t_page(p: uint): uint

fn fill(p: ptr uint, v: uint) { var i: uint = 0; while i < 4096 { p[i] = v + i; i++ } }
fn same(p: ptr uint, v: uint): uint { var i: uint = 0; while i < 4096 { if p[i] != v + i { return 0 }; i++ }; return 1 }
fn zero(p: ptr uint): uint { var i: uint = 0; while i < 4096 { if p[i] != 0 { return 0 }; i++ }; return 1 }

var W5: ptr uint = ptr uint($A000)
var W6: ptr uint = ptr uint($C000)

fn xm(page: uint, f: uint): (uint, uint) { var e, o: uint; e, o = sys_xmap(page, f); return e, o }
fn inval(page: uint, f: uint): uint { var e, o: uint; e, o = sys_xmap(page, f); return uint(e == E_INVAL && o == 0) }
fn fault(a: uint): uint {
    var e, h, n: uint
    e, h = sys_open("dev:nul", O_WRITE, 0)
    e, n = sys_write(h, ptr byte(a), 10)
    sys_close(h)
    return uint(e == E_FAULT)
}
fn xcount(): uint { var e, t, f, x: uint; e, t, f, x = sys_meminfo(); return x }

var brk_n: uint
interrupt fn on_break() { brk_n++ }

fn utoa(v: uint, b: ptr byte) {
    var t: [6]byte
    var n: uint = 0
    loop { t[n] = byte('0' + v % 10); n++; v /= 10; if v == 0 { break } }
    var i: uint = 0
    while n != 0 { n--; b[i] = t[n]; i++ }
    b[i] = 0
}

fn child(argv: ptr ptr byte): int {
    var e, o, g, pf, ok: uint
    var r = argv[1]
    if r[0] == 'c' {
        pf, ok = atou(argv[2])
        e, g = sys_xalloc()
        e, o = xm(5, g)
        if e != OK || o != XM_OWN || zero(W5) == 0 { return 1 }
        fill(W5, $5000)
        if inval(5, pf) == 0 { return 2 }                   // the parent's frame is foreign
        e, o = xm(6, g)
        if e != OK || o != XM_OWN || same(W6, $5000) == 0 { return 3 }
        if t_page(5) != g || t_page(6) != g { return 4 }
        return int(g)                                        // exit without XFREE
    }
    if r[0] == 'x' {
        e, g = sys_xalloc()
        e, o = xm(5, g)
        var cmd: [40]byte
        var s = "A:/bin/txm2.cx y "
        var i: uint = 0
        while s[i] != 0 { cmd[i] = s[i]; i++ }
        utoa(g, &cmd[i])
        e = sys_exec(&cmd[0])
        return 9
    }
    if r[0] == 'y' {
        g, ok = atou(argv[2])
        if inval(5, g) == 0 { return 1 }                    // the old program's frame is freed
        if xcount() != 0 { return 2 }
        e, g = sys_xalloc()
        e, o = xm(5, g)
        if e != OK || o != XM_OWN || zero(W5) == 0 { return 3 }
        e, o = xm(5, XM_OWN)
        if e != OK || o != g { return 4 }
        return 50
    }
    if r[0] == 'b' && r[1] == 'r' {
        var g2: uint
        e, g = sys_xalloc()
        e, g2 = sys_xalloc()
        var h: ptr interrupt fn()
        e, h = sys_onevent(EVT_BREAK, on_break)
        puts("XLOOPB\n")
        while brk_n == 0 { e, o = xm(5, g); e, o = xm(5, g2) }
        if t_page(5) != g2 && t_page(5) != g { return 1 }
        return 61
    }
    if r[0] == 's' {
        var g2: uint
        e, g = sys_xalloc()
        e, g2 = sys_xalloc()
        puts("XLOOP\n")
        loop { e, o = xm(5, g); e, o = xm(5, g2) }
    }
    if r[0] == 'b' {
        var n: uint
        n, ok = atou(argv[2])
        var g2: uint
        e, g = sys_xalloc()
        e, g2 = sys_xalloc()
        while n != 0 { e, o = xm(5, g); e, o = xm(5, g2); n-- }
        return 0
    }
    return 99
}

fn main(argc: uint, argv: ptr ptr byte): int {
    if argc > 1 { return child(argv) }
    var e, o, f1, f2, f3, code: uint
    check(xcount() == 0, "no extended memory at start")
    e, f1 = sys_xalloc()
    e, f2 = sys_xalloc()
    e, f3 = sys_xalloc()
    check(xcount() == 3, "xalloc: 3 frames")

    // registers, SP, IF and ZF around the fast and the full path
    check(t_xregs(5, f1) == 0, "regs: fast path, extended frame")
    check(t_xregs(5, XM_OWN) == 0, "regs: fast path, XM_OWN")
    check(t_xregs(5, 300) == 0 && t_xregs(9, f1) == 0, "regs: full path, INVAL")

    // values
    e, o = xm(5, f1)
    check(e == OK && o == XM_OWN && zero(W5) != 0 && t_page(5) == f1, "xmap: f1 in page 5, PAGE5 set")
    fill(W5, $1000)
    e, o = xm(6, f2)
    check(e == OK && o == XM_OWN && zero(W6) != 0, "xmap: f2 in page 6")
    fill(W6, $2000)
    e, o = xm(5, f2)
    check(e == OK && o == f1 && same(W5, $2000) != 0, "xmap: one frame in two pages")
    W5[0] = $ABCD
    check(W6[0] == $ABCD, "xmap: write through page 5 seen in page 6")
    W5[0] = $2000
    e, o = xm(5, f1)
    check(e == OK && o == f2 && same(W5, $1000) != 0, "xmap: f1 back")

    // errors do not change the map
    check(inval(5, 13) != 0 && inval(5, 0) != 0 && inval(5, 7) != 0 && inval(5, 8) != 0, "xmap: system frames -> INVAL")
    check(inval(5, 256) != 0 && inval(5, $FFFE) != 0 && inval(5, 255) != 0, "xmap: bad frame numbers -> INVAL")
    check(inval(7, f1) != 0 && inval(8, f1) != 0 && inval($FFFF, f1) != 0, "xmap: bad pages -> INVAL")
    check(inval(5, t_page(0)) != 0 && inval(6, t_page(1)) != 0, "xmap: own frames -> INVAL")
    check(same(W5, $1000) != 0 && same(W6, $2000) != 0 && t_page(5) == f1 && t_page(6) == f2, "xmap: map unchanged after errors")

    // a child: its own map, the parent's map is restored (Proc.map <-> RES.cmap)
    var cmd: [40]byte
    var s = "A:/bin/txm2.cx c "
    var i: uint = 0
    while s[i] != 0 { cmd[i] = s[i]; i++ }
    utoa(f1, &cmd[i])
    e, code = run(&cmd[0])
    check(e == OK && code >= 14 && code < 256, "spawn: child mapped its own frame")
    check(same(W5, $1000) != 0 && same(W6, $2000) != 0 && t_page(5) == f1 && t_page(6) == f2, "spawn: parent map restored")
    check(xcount() == 3 && inval(5, code) != 0, "spawn: child frame freed, not ours")
    e, o = xm(5, f3)
    check(e == OK && o == f1 && zero(W5) != 0, "xmap after child: old value from parent map")
    e, o = xm(5, f1)
    e, code = run("A:/bin/txm2.cx x")
    check(e == OK && code == 50, "exec: extended frames of the old program gone")
    check(same(W5, $1000) != 0 && t_page(5) == f1, "exec: parent map restored")

    // SETTOP and a page with an extended-memory frame
    check(sys_settop($C000) == OK && same(W5, $1000) != 0 && t_page(5) == f1, "settop grow: page 5 keeps f1")
    e, o = xm(5, XM_OWN)
    check(e == OK && o == f1 && zero(W5) != 0 && t_page(5) != f1, "settop grow: XM_OWN -> new own frame")
    fill(W5, $7000)
    e, o = xm(5, f1)
    check(e == OK && o == XM_OWN && same(W5, $1000) != 0, "settop grow: f1 back, old is own")
    e, o = xm(5, XM_OWN)
    check(e == OK && o == f1 && same(W5, $7000) != 0, "settop grow: own frame kept its data")
    e, o = xm(5, f1)
    check(sys_settop($A000) == OK && same(W5, $1000) != 0 && t_page(5) == f1, "settop shrink: page 5 keeps f1")
    e, o = xm(5, XM_OWN)
    check(e == OK && o == f1 && fault($A000) != 0, "settop shrink: XM_OWN -> no frame")
    e, o = xm(5, XM_OWN)
    check(e == OK && o == XM_OWN, "xmap: XM_OWN over XM_OWN")

    // XFREE removes the frame from all pages
    e, o = xm(5, f2)
    check(e == OK && o == XM_OWN, "xmap: f2 in pages 5 and 6")
    check(sys_xfree(f2) == OK && fault($A000) != 0 && fault($C000) != 0, "xfree: both pages lost the frame")
    check(t_page(5) == 13 && t_page(6) == 13, "xfree: PAGE5, PAGE6 - garbage frame")
    check(inval(5, f2) != 0 && sys_xfree(f2) == E_INVAL, "xfree: frame no longer ours")
    e, o = xm(6, f3)
    check(e == OK && o == XM_OWN, "xmap: after xfree, old is own")

    // Ctrl+C in an XMAP loop
    e, code = run("A:/bin/txm2.cx brk")
    check(e == OK && code == 61, "ctrl+c: handler called in an XMAP loop")
    e, code = run("A:/bin/txm2.cx spin")
    check(e == OK && code == $8001, "ctrl+c: XMAP loop terminated")
    check(xcount() == 2 && t_page(6) == f3, "ctrl+c: parent state kept")

    check(sys_xfree(f1) == OK && sys_xfree(f3) == OK && xcount() == 0, "xfree: all")
    return finish()
}
