# manual check of fm: tests/fm/run.sh tests/fm/tree.scn 2>/dev/null | python3 tests/fm/show.py
after "A:/> " steps 2000 type "cd /data\n"
after "A:/data> " steps 2000 type "fm 1:\n"
screen " B:/ " steps 300000 key 00 50
screen "sub                 │  Folder" steps 100000 key 00 3F
screen " to:" steps 30000 type "\n"
after "" steps 800000 type "\t"
after "" steps 100000 key 00 47
after "" steps 30000 type "\n"
after "" steps 200000 dump
after "" steps 10 type "\t"
after "" steps 100000 key 00 41
screen "Create the directory" steps 10000 type "newdir\n"
after "" steps 300000 dump
after "" steps 10 key 00 47
after "" steps 30000 key 00 50
after "" steps 30000 key 00 50
after "" steps 30000 key 00 42
screen "Delete the directory" steps 30000 dump
after "" steps 10 type "y"
after "" steps 800000 dump
after "" steps 10 type "ls -l\n"
screen "press any key" steps 2000000 dump
after "" steps 10 type " "
after "" steps 300000 key 00 44
screen "quit fm" steps 2000 type "y"
after "A:/data> " steps 2000 type "exit\n"
