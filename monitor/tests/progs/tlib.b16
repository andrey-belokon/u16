// tlib.b16 - common functions of the test programs: a check and a summary.
include "sys.b16"

var fails: uint

fn check(ok: uint, what: ptr byte) {
    if ok != 0 { puts("ok   ") } else { puts("FAIL "); fails++ }
    puts(what)
    putnl()
}

// The summary. On failure the system halts at once: a shell with a nonzero code would be restarted.
fn finish(): int {
    if fails != 0 { puts("FAILED\n"); sys_shutdown() }
    puts("ALL OK\n")
    return 0
}

// Launching a child with the parent's standard streams: the error code, the exit code.
fn run(cmd: ptr byte): (uint, uint) {
    var e, c: uint
    e, c = sys_spawn(cmd, SAME, SAME, SAME)
    return e, c
}
