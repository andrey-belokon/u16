// console.b16 - the console: kernel output, the event ring, line and raw input
// ("CPU16 Monitor: Kernel Internals", sect. 5; "System Calls", sect. 6).

fn kputc(c: uint) { CON_DATA = byte(c) }

fn kputs(s: ptr byte) {
    while *s != 0 { CON_DATA = *s; s++ }
}

fn khex(v: uint) {
    var sh: uint = 16
    while sh != 0 {
        sh -= 4
        var d: uint = (v >> sh) & 15
        if d < 10 { kputc('0' + d) } else { kputc('A' + d - 10) }
    }
}

// ---- the event ring (filled by irq0) ------------------------------------------------
fn ev_empty(): uint {
    if RES.kb_tail == RES.kb_head { return 1 }
    return 0
}

var ev_mods: uint              // modifiers of the event that ev_get returned last

fn ev_get(): uint {
    var t: uint = RES.kb_tail
    var ev: uint = RES.kb[t >> 1]
    ev_mods = RES.kbm[t >> 1]
    RES.kb_tail = (t + 2) & KB_MASK
    return ev
}

// A switch to another session during a wait (sect. 3.8): the call will be executed again when the
// process becomes current once more. The frame KF does not change (the call arguments stay in it), IP
// returns to the TRAP instruction; the switch itself is done by kexit on leaving the kernel.
const E_SWITCH = $FFFE          // a code only inside the kernel: the process does not receive it

fn wait_restart(): uint {
    RES.kf_set = 1
    KF[F_IP] = KF[F_IP] - 4     // TRAP #9 and the number word
    return E_SWITCH
}

// An interruptible wait (sect. 3.6 of the kernel design): OK - there is an event, E_INTR or E_SWITCH.
fn ev_wait(): uint {
    while ev_empty() != 0 {
        if RES.abort != 0 && RES.nobreak == 0 { return E_INTR }
        if RES.sw_req != 0 { return wait_restart() }
        wfi()
        ei()
        di()
    }
    return OK
}

// ---- the line-mode line ---------------------------------------------------------
var ln: [256]byte
var ln_len: uint
var ln_pos: uint
var ln_ready: uint              // 1 - the line is finished with Enter and not yet read completely
var ln_eof: uint                // 1 - Ctrl+Z at the start of a line: READ returns 0 bytes

fn ln_reset() {
    ln_len = 0
    ln_pos = 0
    ln_ready = 0
    ln_eof = 0
}

// irq0 discarded the ring (Ctrl+C with a handler) - discard the line too.
fn ln_check_drop() {
    if RES.ln_drop != 0 { RES.ln_drop = 0; ln_reset() }
}

fn con_flush() {
    RES.kb_tail = RES.kb_head
    ln_reset()
}

fn rubout(echo: uint) {
    if echo != 0 { kputc(8); kputc(' '); kputc(8) }
}

// Typing a line until Enter or Ctrl+Z (sect. 6.2 of the calls): OK or E_INTR.
fn con_fill_line(): uint {
    var echo: uint = 1
    if curp().conmode & CM_NOECHO != 0 { echo = 0 }
    while ln_ready == 0 {
        var e: uint = ev_wait()
        if e != OK { return e }
        var c: uint = ev_get() & $FF
        if c == 3 {
            // Ctrl+C gets here only with NOBREAK: cancel the line
            ln_len = 0
            kputs("^C\n")
            return E_INTR
        } else if c == $0A {
            ln[ln_len] = $0A
            ln_len++
            ln_pos = 0
            ln_ready = 1
            if echo != 0 { kputc($0A) }
        } else if c == 8 {
            if ln_len != 0 { ln_len--; rubout(echo) }
        } else if c == $15 {
            while ln_len != 0 { ln_len--; rubout(echo) }
        } else if c == $1A {
            if ln_len == 0 { ln_eof = 1; return OK }
        } else if c >= $20 || c == 9 {
            if ln_len < 255 {
                ln[ln_len] = byte(c)
                ln_len++
                if echo != 0 { kputc(c) }
            }
        }
    }
    return OK
}

var rawbuf: [256]byte

// READ of the console into the process buffer (checked in advance): the error code, the count read.
fn con_read(ua: uint, n: uint): (uint, uint) {
    if n == 0 { return OK, 0 }
    ln_check_drop()
    var e: uint
    if curp().conmode & CM_RAW != 0 {
        loop {
            e = ev_wait()
            if e != OK { return e, 0 }
            var cnt: uint = 0
            while cnt < n && cnt < 256 && ev_empty() == 0 {
                var c: uint = ev_get() & $FF
                if c != 0 { rawbuf[cnt] = byte(c); cnt++ }
            }
            if cnt != 0 {
                e = ucopyout(ua, &rawbuf[0], cnt)
                return e, cnt
            }
        }
    }
    if ln_ready == 0 && ln_eof == 0 {
        e = con_fill_line()
        if e != OK { return e, 0 }
    }
    if ln_eof != 0 {
        ln_eof = 0
        return OK, 0
    }
    var m: uint = ln_len - ln_pos
    if m > n { m = n }
    e = ucopyout(ua, &ln[ln_pos], m)
    ln_pos += m
    if ln_pos == ln_len { ln_reset() }
    return e, m
}

// WRITE to the console from the process buffer (checked in advance).
fn con_write(ua: uint, n: uint) {
    var p = curp()
    while n != 0 {
        var k: ptr byte
        var a: uint
        k, a = pwin(p, ua)
        if a > n { a = n }
        ua += a
        n -= a
        while a != 0 { CON_DATA = *k; k++; a-- }
    }
}

// The current process's mode became known to the kernel: a copy of NOBREAK for irq0.
fn con_mode_apply(mode: uint) {
    if mode & CM_NOBREAK != 0 {
        RES.nobreak = 1
        RES.abort = 0
    } else {
        RES.nobreak = 0
    }
}
